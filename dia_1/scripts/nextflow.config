profiles {
    conda {
        conda.enabled = true
    }
    cluster {
        process.executor = 'slurm'
        process.queue    = 'short'
        process.cpus     = 4
        process.memory   = '8 GB'
        process.time     = '24h'
        conda.enabled    = true
    }
    local {
        process.executor = 'local'
        conda.enabled    = false
    }
}