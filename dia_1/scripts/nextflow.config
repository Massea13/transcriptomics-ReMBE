profiles {
    conda {
        conda.enabled = true
    }
    cluster {
        process.executor   = 'slurm'
        process.queue      = 'short'
        process.cpus       = 2
        process.memory     = '4 GB'
        process.time       = '4h'
        conda.enabled      = true

        executor.queueSize     = 20        // permite hasta 20 jobs concurrentes
        executor.pollInterval  = '10 sec'  // consulta SLURM cada 10 s
    }
    local {
        process.executor = 'local'
        conda.enabled    = false
    }
}

// Ajustes por proceso (sobrescriben los valores del perfil)
process {
    withName: 'FASTQC_RAW|FASTQC_TRIMMED' {
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
    }
    withName: 'TRIM' {
        cpus          = 4
        memory        = '8 GB'
        time          = '4h'
        errorStrategy = 'retry'
        maxRetries    = 1
    }
    withName: 'MULTIQC' {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }
}